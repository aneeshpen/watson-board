# Frontend build-time configuration. Copy to `.env` for local overrides.

# Base URL of the Watson-Board backend.
# Leave EMPTY in development: the Vite dev server proxies /api to :8000.
# REQUIRED for a production build — the static bundle has no proxy, so without
# this every API call resolves against the static host and 404s.
#
# Example: VITE_API_BASE_URL=https://watson-board-api.example.com
VITE_API_BASE_URL=
