# Copy to backend/.env and fill in. Never commit the real .env.

ENVIRONMENT=development
DEBUG=false

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required in any deployed environment. Guards POST /api/pmi/train and
# the CCTV upload endpoints. Leave unset locally to run without auth.
ADMIN_API_KEY=

# Enables generated Copilot answers. Without it the Copilot falls back to
# retrieval-only mode and the app still runs.
ANTHROPIC_API_KEY=
COPILOT_MODEL=claude-opus-5
COPILOT_RETRIEVAL_K=6

# Limits
MAX_PAGE_SIZE=200
MAX_SEARCH_RESULTS=25
MAX_UPLOAD_MB=500
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_EXPENSIVE=10/minute
